{
  "$schema_version": 2,
  "$id": "xhentai85",
  "$type": "comic",
  "$name": "無限動漫H（xhentai85）",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "adult": true,
    "homepage": "https://xhentai85.xyz",
    "description": "xhentai85（站内现名「老司機禁漫 / 无尽漫画」，日韓全彩成人漫畫，GBK）。2026-11 站方改版：全站路由改为「查询串即路径」形式——作品 ?comic/{id}、章节 ?comic/{id}/{token}、分类 ?comics/{分类}/ob/{排序}/st/{进度}/page/{n}。旧 ?novel{N}/、?latest/index_2.html 已 404（发现页整页空白即此原因）。注意：站点边缘（aaPanel/nginx）对查询串里带百分号编码的请求一律返回 404，因此分类只能用 ASCII 路由，中文分类/中文搜索（?search/{中文}、/catalog.php?key=）目前站方不可用，本源不配搜索。封面与正文图走 new.niaopic.com / img.nnpic.xyz，无防盗链，直连即可取图。",
    "lang": "zh-TW",
    "region": "cn",
    "tags": [
      "漫画",
      "成人",
      "彩色",
      "日漫",
      "韩漫"
    ],
    "last_verified": "2026-11-06T10:20:00+08:00"
  },
  "transports": {
    "base_url": "https://xhentai85.xyz",
    "charset": "gbk",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9"
    },
    "timeout": 15,
    "retries": 3,
    "interval_ms": 700
  },
  "endpoints": {
    "discovery": {
      "list_url": "/?comics/all/ob/time/st/all/page/{page}",
      "list_paginator": {
        "type": "increment"
      },
      "list_item": {
        "categories": [
          {
            "title": "最新更新",
            "url": "/?comics/all/ob/time/st/all/page/{page}"
          },
          {
            "title": "連載中",
            "url": "/?comics/all/ob/time/st/serialized/page/{page}"
          },
          {
            "title": "已完結",
            "url": "/?comics/all/ob/time/st/completed/page/{page}"
          },
          {
            "title": "本週熱門",
            "url": "/?comics/all/ob/hits/st/all/page/{page}"
          },
          {
            "title": "熱門連載",
            "url": "/?comics/all/ob/hits/st/serialized/page/{page}"
          },
          {
            "title": "熱門完結",
            "url": "/?comics/all/ob/hits/st/completed/page/{page}"
          },
          {
            "title": "評分最高",
            "url": "/?comics/all/ob/stars/st/all/page/{page}"
          },
          {
            "title": "高分完結",
            "url": "/?comics/all/ob/stars/st/completed/page/{page}"
          }
        ]
      },
      "works_list_item": {
        "root_selector": {
          "css": "div.comic-list > a[href^='?comic/']"
        },
        "fields": {
          "title": {
            "css": "div.title"
          },
          "url": {
            "xpath": "self::a",
            "attr": "href"
          },
          "cover": {
            "css": "picture img",
            "attr": "src"
          },
          "update": {
            "css": "div.last-time"
          }
        },
        "clean": {
          "update": [
            [
              "re:\\s*\\d+(?:\\.\\d+)?分\\s*$",
              ""
            ]
          ]
        }
      }
    },
    "detail": {
      "fields": {
        "title": {
          "css": "div.detail h1"
        },
        "cover": {
          "css": "div.detail-cover img",
          "attr": "src"
        },
        "author": {
          "css": "div.detail td a[href^='?search/']"
        },
        "summary": {
          "css": "div.mt-4.text-break"
        },
        "tags": {
          "css": "div.detail td a[href^='?comics/']"
        }
      }
    },
    "content": {
      "page": {
        "list": {
          "root_selector": {
            "css": "div.vol-item"
          },
          "fields": {
            "title": {
              "css": "span.vol-item-info a"
            },
            "url": {
              "css": "a[href^='?comic/']",
              "attr": "href"
            }
          }
        },
        "body": {
          "root_selector": {
            "css": "img[data-index]"
          },
          "fields": {
            "url": {
              "xpath": "self::img",
              "attr": "src"
            }
          }
        }
      }
    }
  },
  "constraints": {
    "detail": {
      "max_pages": 1
    },
    "page": {
      "max_pages": 1
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "off"
    }
  }
}
