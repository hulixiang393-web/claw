{
  "$schema_version": 2,
  "$id": "fdzys",
  "$type": "video",
  "$name": "饭搭子影视",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://fdzys.com/",
    "description": "饭搭子影视 - 免费电影/电视/综艺/动漫（MacCMS，多播放源换源）",
    "lang": "zh-CN",
    "region": "cn",
    "tags": ["视频", "免费", "影视", "换源"]
  },
  "transports": {
    "base_url": "https://fdzys.com",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Referer": "https://fdzys.com/"
    },
    "timeout": 20,
    "retries": 3,
    "interval_ms": 500
  },
  "endpoints": {
    "discovery": {
      "list_url": "/tv/all",
      "list_paginator": {
        "type": "increment",
        "start": 1,
        "step": 1,
        "param": "page"
      },
      "list_item": {
        "categories": [
          { "title": "全部", "url": "/tv/all" },
          { "title": "国产剧", "url": "/tv/guochan" },
          { "title": "欧美剧", "url": "/tv/oumei" },
          { "title": "日本剧", "url": "/tv/riben" },
          { "title": "韩国剧", "url": "/tv/hanguo" }
        ]
      },
      "works_list_item": {
        "root_selector": { "css": ".myui-vodbox-content" },
        "fields": {
          "title": { "css": "img", "attr": "alt" },
          "url": { "css": "a[href*='/tv/']", "attr": "href" },
          "cover": { "css": "img", "attr": "data-src" }
        }
      }
    },
    "search": {
      "base_url": "/search",
      "method": "GET",
      "keyword_param": "wd",
      "render": "playwright",
      "item": {
        "root_selector": { "css": "a[href*='/yu-']" },
        "render_config": {
          "interact": true,
          "home_url": "https://fdzys.com/",
          "input_selector": "input[name='wd']",
          "wait_until": "networkidle",
          "extra_delay_ms": 3000,
          "timeout_ms": 30000
        }
      }
    },
    "detail": {
      "url_pattern": "/tv/[\\w-]+",
      "fields": {
        "title": { "css": "meta[property='og:title']", "attr": "content" },
        "cover": { "css": "meta[property='og:image']", "attr": "content" },
        "summary": { "css": "meta[property='og:description']", "attr": "content" },
        "author": { "css": "meta[property='og:video:actor']", "attr": "content" }
      }
    },
    "content": {
      "episode": {
        "source_switch": {
          "param": "sid",
          "default_sid": "1",
          "list_selector": ".player_name[data-sid]",
          "list_attr": "data-sid",
          "name_selector": ".player_name",
          "ep_list_selector": "#playlist{sid} a[href*='/tv/']",
          "play_regex": "var player_aaaa=(\\{.*?\\})\\s*</script>",
          "play_url_path": "url",
          "playerconfig_url": "/static/js/playerconfig.js"
        },
        "play_url": {
          "selector": { "css": "video#player source", "attr": "src" }
        }
      }
    }
  },
  "media": {
    "format": "hls",
    "select": {
      "video": { "quality": "best" }
    },
    "merge": {
      "tool": "ffmpeg",
      "output_format": "mp4"
    }
  },
  "constraints": {
    "search": { "max_pages": 1, "max_results": 30 },
    "detail": { "max_pages": 1 },
    "episode": { "max_pages": 1, "max_items": 200 }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "off",
      "selector": { "css": ".player_name[data-sid]" }
    }
  }
}
