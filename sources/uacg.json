{
  "$schema_version": 2,
  "$id": "uacg",
  "$type": "video",
  "$name": "UACG",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://uacg.moe",
    "icon": "https://uacg.moe/favicon.ico",
    "description": "UACG（uacg.moe）AI/3D/Galgame 动画视频站（多为 R18，需解锁）。搜索/发现/详情走 v3 JSON API（全部匿名可用）：search-results（data.videos.items，无分页，top 结果）、publication-feed（data.items + nextCursor，框架发现仅取首页 20）、catalog/videos/{id}（数字与 UUID 两种 id 均支持）。免费可直接下载的仅各视频 5 秒 640x360 无声预览 mp4（extraInfo.previewUrl，CloudFront 直链 GET 200）；完整正片是 vault HLS：须 POST /api/v3/media/videos/{id}/playback 换带 JWT 的 master.m3u8（GET 同址返回 405），且该 master 匿名/未解锁一律 403（含真实浏览器登录页），框架 episode 只支持 GET 无法接入，故仅配置预览 mp4。部分视频无 previewUrl（纯 vault 内容）→ episode 取空、下载报错属正常。",
    "lang": "zh-CN",
    "region": "cn",
    "tags": [
      "视频",
      "动画",
      "AI生成",
      "3D",
      "成人(R18)"
    ],
    "last_verified": "2026-09-07"
  },
  "transports": {
    "base_url": "https://uacg.moe",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36",
      "Accept": "application/json, text/plain, */*",
      "Accept-Language": "zh-CN,zh;q=0.9",
      "Referer": "https://uacg.moe/"
    },
    "timeout": 15,
    "retries": 3,
    "interval_ms": 300
  },
  "api_endpoints": {
    "discovery": {
      "url": "/api/v3/discovery/publication-feed/items",
      "params": {
        "types": "video",
        "limit": "20"
      },
      "response_path": "data.items",
      "item_fields": {
        "title": "title",
        "url": "https://uacg.moe/video/{id}",
        "cover": "coverUrl",
        "author": "uploader.name",
        "update": "publishedAt"
      },
      "list_item": {
        "categories": [
          {
            "title": "最新",
            "url": "https://uacg.moe/api/v3/discovery/publication-feed/items?types=video&limit=20"
          }
        ]
      }
    },
    "search": {
      "url": "/api/v3/discovery/search-results",
      "params": {
        "query": "{keyword}"
      },
      "response_path": "data.videos.items",
      "item_fields": {
        "title": "title",
        "url": "https://uacg.moe/video/{id}",
        "cover": "coverUrl",
        "author": "uploader.nickname",
        "update": "publishedAt"
      }
    },
    "detail": {
      "url": "/api/v3/catalog/videos/{id}",
      "field_extractors": {
        "title": "title",
        "author": "uploader.nickname",
        "cover": "coverUrl",
        "summary": "description"
      }
    },
    "episode": {
      "url": "/api/v3/catalog/videos/{id}",
      "response_path": "data.extraInfo.previewUrl"
    }
  },
  "media": {
    "format": "mp4",
    "select": {
      "video": {
        "quality": "best"
      }
    },
    "merge": {
      "tool": "ffmpeg",
      "output_format": "mp4"
    }
  },
  "constraints": {
    "search": {
      "max_pages": 1,
      "max_results": 30
    },
    "detail": {
      "max_pages": 1
    },
    "episode": {
      "max_pages": 1,
      "max_items": 1
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "off"
    }
  }
}
