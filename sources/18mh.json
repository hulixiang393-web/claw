{
  "$schema_version": 2,
  "$id": "18mh",
  "$type": "comic",
  "$name": "禁漫天堂(18mh)",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://18mh.net/",
    "description": "禁漫天堂 - 成人漫画源",
    "lang": "zh-CN",
    "region": "cn",
    "tags": [
      "漫画",
      "成人",
      "免费"
    ]
  },
  "transports": {
    "base_url": "https://18mh.net",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Referer": "https://18mh.net/"
    },
    "timeout": 10,
    "retries": 2,
    "interval_ms": 800
  },
  "endpoints": {
    "discovery": {
      "list_url": "/comic/all",
      "list_paginator": {
        "type": "increment",
        "start": 1,
        "step": 1,
        "param": "page"
      },
      "list_item": {
        "categories": [
          {
            "title": "全部",
            "url": "/comic/all"
          },
          {
            "title": "爱情",
            "url": "/comic/all/aq"
          },
          {
            "title": "BL",
            "url": "/comic/all/bl"
          },
          {
            "title": "单本",
            "url": "/comic/all/db"
          },
          {
            "title": "短篇",
            "url": "/comic/all/dp"
          },
          {
            "title": "韩国H漫",
            "url": "/comic/all/hg"
          },
          {
            "title": "禁漫",
            "url": "/comic/all/jq"
          },
          {
            "title": "连载",
            "url": "/comic/all/ll"
          },
          {
            "title": "清末",
            "url": "/comic/all/qh"
          },
          {
            "title": "日韩",
            "url": "/comic/all/rb"
          },
          {
            "title": "同人",
            "url": "/comic/all/tj"
          },
          {
            "title": "汉化",
            "url": "/comic/all/tr"
          },
          {
            "title": "校园",
            "url": "/comic/all/xy"
          }
        ]
      },
      "works_list_item": {
        "root_selector": {
          "css": "ul.dx-novel-list li"
        },
        "fields": {
          "title": {
            "css": "h2, h3"
          },
          "url": {
            "css": "a[href*='/comic/detail/']",
            "attr": "href"
          },
          "cover": {
            "css": "img",
            "attr": "data-src"
          }
        }
      }
    },
    "search": {
      "base_url": "/comic/search/{keyword}",
      "method": "GET",
      "keyword_param": "keyword",
      "paginator": {
        "url_template": "/comic/search/{keyword}/page/{page}"
      },
      "item": {
        "root_selector": {
          "css": "ul.dx-novel-list li"
        },
        "fields": {
          "title": {
            "css": "h2, h3"
          },
          "url": {
            "css": "a[href*='/comic/detail/']",
            "attr": "href"
          },
          "cover": {
            "css": "img",
            "attr": "data-src"
          }
        }
      }
    },
    "detail": {
      "fields": {
        "title": {
          "css": "h1"
        },
        "author": {
          "css": "a[href*='/comic/all/author/']"
        },
        "cover": {
          "css": "meta[property='og:image']",
          "attr": "content"
        },
        "summary": {
          "css": ".detail-intro__text"
        },
        "status": {
          "css": "span.detail-page__cover-corner-badge"
        },
        "tags": {
          "css": "a.detail-page__tag"
        }
      }
    },
    "content": {
      "page": {
        "list": {
          "root_selector": {
            "css": "a.detail-page__catalog-item"
          },
          "chapter_order": "asc",
          "title_clean": true,
          "fields": {
            "title": {
              "css": "span.detail-page__chapter-title"
            },
            "url": {
              "css": "a.detail-page__catalog-item",
              "attr": "href"
            }
          }
        },
        "body": {
          "root_selector": {
            "css": "img[data-src]"
          },
          "fields": {
            "url": {
              "css": "img[data-src]",
              "attr": "data-src"
            }
          }
        }
      }
    }
  },
  "constraints": {
    "search": {
      "max_pages": 30,
      "max_results": 1440
    },
    "detail": {
      "max_pages": 1
    },
    "page": {
      "max_pages": 300,
      "max_items": 300
    }
  },
  "decryption": {
    "targets": {
      "image": {
        "strategy": "aes_cbc",
        "key": "f5d965df75336270",
        "iv": "97b60394abc2fbe1",
        "padding": "none",
        "input": "bytes",
        "output": "bytes"
      }
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "soft",
      "selector": {
        "css": "a[href*='/comic/detail/']"
      }
    }
  }
}
