{
  "$schema_version": 2,
  "$id": "18mh",
  "$type": "comic",
  "$name": "禁漫天堂(18mh)",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "adult": true,
    "homepage": "https://18mh.net/",
    "description": "禁漫天堂 - 成人漫画源（jm-v4 版式）",
    "lang": "zh-CN",
    "region": "cn",
    "tags": [
      "漫画",
      "成人",
      "免费"
    ]
  },
  "transports": {
    "base_url": "https://18mh.net",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Referer": "https://18mh.net/",
      "Upgrade-Insecure-Requests": "1",
      "Sec-Fetch-Site": "same-origin",
      "Sec-Fetch-Mode": "navigate",
      "Sec-Fetch-User": "?1",
      "Sec-Fetch-Dest": "document"
    },
    "timeout": 10,
    "retries": 2,
    "interval_ms": 800
  },
  "endpoints": {
    "discovery": {
      "list_url": "/comic/all",
      "note": "2026-10 站点换版为 jm-v4 版式：旧版 ul.dx-novel-list / .detail-page__catalog-item 全部消失，列表改为 ul.jm-grid--book > li.jm-card（每页固定 20 张，SSR 全量输出、封面在 img[data-src]、title 取 h3.jm-card__title 内 a），分页仍是 /comic/all/page/{n}（页顶 pager 的 data-link/data-page）。",
      "list_paginator": {
        "type": "increment",
        "start": 1,
        "step": 1,
        "param": "page"
      },
      "list_item": {
        "categories": [
          {
            "title": "全部",
            "url": "/comic/all"
          },
          {
            "title": "爱情",
            "url": "/comic/all/aq"
          },
          {
            "title": "BL",
            "url": "/comic/all/bl"
          },
          {
            "title": "单本",
            "url": "/comic/all/db"
          },
          {
            "title": "短篇",
            "url": "/comic/all/dp"
          },
          {
            "title": "韩国H漫",
            "url": "/comic/all/hg"
          },
          {
            "title": "禁漫",
            "url": "/comic/all/jq"
          },
          {
            "title": "连载",
            "url": "/comic/all/ll"
          },
          {
            "title": "清末",
            "url": "/comic/all/qh"
          },
          {
            "title": "日韩",
            "url": "/comic/all/rb"
          },
          {
            "title": "同人",
            "url": "/comic/all/tj"
          },
          {
            "title": "汉化",
            "url": "/comic/all/tr"
          },
          {
            "title": "校园",
            "url": "/comic/all/xy"
          }
        ]
      },
      "works_list_item": {
        "root_selector": {
          "css": "ul.jm-grid--book > li.jm-card"
        },
        "fields": {
          "title": {
            "css": "h3.jm-card__title a"
          },
          "url": {
            "css": "a.jm-card__cover",
            "attr": "href"
          },
          "cover": {
            "fallback": [
              {
                "css": "img.jm-card__img",
                "attr": "data-src"
              },
              {
                "css": "img.jm-card__img",
                "attr": "data-original"
              },
              {
                "css": "img.jm-card__img",
                "attr": "src"
              }
            ]
          }
        }
      }
    },
    "search": {
      "base_url": "/comic/search/{keyword}",
      "method": "GET",
      "keyword_param": "keyword",
      "note": "搜索结果不是卡片网格，而是 a.jm-rrow 行式条目（/static 的 jm-sr-pg 分页，实测 /comic/search/{kw}/page/{n} 仍可用）。",
      "paginator": {
        "url_template": "/comic/search/{keyword}/page/{page}"
      },
      "item": {
        "root_selector": {
          "css": "a.jm-rrow"
        },
        "fields": {
          "title": {
            "css": ".jm-rrow__title"
          },
          "url": {
            "css": "a.jm-rrow",
            "attr": "href"
          },
          "cover": {
            "fallback": [
              {
                "css": "img.jm-rrow__img",
                "attr": "data-src"
              },
              {
                "css": "img.jm-rrow__img",
                "attr": "data-original"
              },
              {
                "css": "img.jm-rrow__img",
                "attr": "src"
              }
            ]
          }
        }
      }
    },
    "detail": {
      "fields": {
        "title": {
          "css": "h1.jm-dt-title"
        },
        "author": {
          "css": ".jm-dt-meta a[href*='/comic/all/author/']"
        },
        "cover": {
          "fallback": [
            {
              "css": "img.jm-dt-cover__img",
              "attr": "data-src"
            },
            {
              "css": "meta[property='og:image']",
              "attr": "content"
            }
          ]
        },
        "summary": {
          "css": ".jm-dt-desc__p"
        },
        "status": {
          "css": ".jm-dt-pill--st"
        },
        "tags": {
          "css": ".jm-dt-tags a.jm-dt-chip"
        }
      }
    },
    "content": {
      "page": {
        "list": {
          "root_selector": {
            "css": ".jm-dt-chap a.jm-dt-ch"
          },
          "chapter_order": "asc",
          "title_clean": false,
          "note": "jm-v4 的目录项是 .jm-dt-chap 内的 a.jm-dt-ch（span.jm-dt-ch__no 为『第 N 话』/『第N章』，span.jm-dt-ch__t 为章节名）。整串取 text_content 时两者无分隔会粘成『第 1 话AI Generated』，因此 title 用 span.jm-dt-ch__t，章节序号由 span.jm-dt-ch__no 的『第N话』提供（框架 _extract_chapter_number 也识别『第 1 话』）。",
          "fields": {
            "title": {
              "css": "span.jm-dt-ch__no, span.jm-dt-ch__t"
            },
            "url": {
              "css": "a.jm-dt-ch",
              "attr": "href"
            }
          }
        },
        "body": {
          "selector": {
            "css": ".jm-rd-read"
          },
          "image_selector": {
            "css": ".jm-rd-stage--comic"
          },
          "note": "阅读页（/comic/chapter/{id}/{page}）版式改为 .jm-rd-stage--comic，图片仍是懒加载 data-src（xi.dzuxta.cn 带 auth_key 的加密图，沿用 decryption.targets.image 的 AES-CBC 解密）。漫画页正文规则键是 body.selector / body.image_selector（列表条目才用 root_selector/fields）；selector 取 .jm-rd-read 而不是 .jm-rd-stage--comic：stage 只有图片、text_content 为空，会让框架误判『未解析到正文 → 走正文解密』直接报错；.jm-rd-read 混入的『前一章/返回书页/下一章』导航文字在阅读器里并入图片流之前显示，不影响整话图片渲染。"
        },
        "ad_block": true
      }
    }
  },
  "constraints": {
    "search": {
      "max_pages": 30,
      "max_results": 1440
    },
    "detail": {
      "max_pages": 1
    },
    "page": {
      "max_pages": 300,
      "max_items": 300
    }
  },
  "decryption": {
    "targets": {
      "image": {
        "strategy": "aes_cbc",
        "key": "f5d965df75336270",
        "iv": "97b60394abc2fbe1",
        "padding": "none",
        "input": "bytes",
        "output": "bytes"
      },
      "chapter": {
        "strategy": "translit",
        "map": [
          "前一章",
          "返回书页",
          "下一章"
        ]
      }
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "soft",
      "selector": {
        "css": "a[href*='/comic/detail/']"
      }
    }
  }
}
