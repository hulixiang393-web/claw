{
  "$schema_version": 2,
  "$id": "quanben",
  "$type": "novel",
  "$name": "全本小说网",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://quanben-xiaoshuo.com",
    "icon": "https://quanben-xiaoshuo.com/favicon.ico",
    "description": "全本小说网 - 全本免费小说阅读网站（列表纯文本无封面，目录为独立页）",
    "lang": "zh-CN",
    "region": "cn",
    "tags": [
      "小说",
      "免费",
      "全本"
    ]
  },
  "transports": {
    "base_url": "https://quanben-xiaoshuo.com",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Referer": "https://quanben-xiaoshuo.com/"
    },
    "timeout": 10,
    "retries": 2,
    "interval_ms": 1000
  },
  "endpoints": {
    "discovery": {
      "list_url": "/",
      "list_item": {
        "fields": {
          "title": {
            "css": "ul.list li a[href*='/category/'] span[itemprop='name']"
          },
          "url": {
            "css": "ul.list li a[href*='/category/']",
            "attr": "href"
          }
        },
        "url_pattern": "/category/"
      },
      "works_list_item": {
        "root_selector": {
          "css": "ul.list2 li"
        },
        "fields": {
          "title": {
            "css": "span[itemprop='name']"
          },
          "url": {
            "css": "a[itemprop='url']",
            "attr": "href"
          }
        }
      }
    },
    "search": {
      "base_url": "/?c=book&a=search",
      "method": "GET",
      "keyword_param": "keyword",
      "render": "playwright",
      "item": {
        "root_selector": {
          "css": "div.book"
        },
        "fields": {
          "title": {
            "css": "h1 a"
          },
          "url": {
            "css": "h1 a",
            "attr": "href"
          }
        },
        "render_config": {
          "wait_until": "domcontentloaded",
          "extra_delay_ms": 5000,
          "timeout_ms": 40000
        }
      }
    },
    "detail": {
      "url_pattern": "/n/[^/]+/?$",
      "fields": {
        "title": {
          "css": "div.info h1.h1"
        },
        "author": {
          "css": "div.info p span[itemprop='author']"
        },
        "cover": {
          "css": "div.pic img",
          "attr": "src"
        },
        "summary": {
          "css": "div.articlebody p"
        }
      }
    },
    "content": {
      "chapter": {
        "list": {
          "chapters_url": "/n/{id}/xiaoshuo.html",
          "chapters_id_regex": "\"/n/([a-z0-9-]+)/xiaoshuo\\.html\"",
          "root_selector": {
            "css": "ul.list li"
          },
          "fields": {
            "title": {
              "css": "span[itemprop='name']"
            },
            "url": {
              "css": "a[itemprop='url']",
              "attr": "href"
            }
          }
        },
        "body": {
          "selector": {
            "css": "#articlebody p"
          }
        }
      }
    }
  },
  "constraints": {
    "search": {
      "max_pages": 1,
      "max_results": 30
    },
    "detail": {
      "max_pages": 1
    },
    "chapter": {
      "max_pages": 500,
      "max_items": 10000
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "soft",
      "selector": {
        "css": "ul.list li a[href*='/category/']"
      },
      "interval_hours": 24,
      "max_failures": 3,
      "auto_disable": true
    }
  }
}
