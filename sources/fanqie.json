      "works_list_item": {
        "root_selector": {
          "css": "a.muye-bottom-choiceness-item, div.rank-book-item, tr.update-list-item"
        },
        "fields": {
          "title": {
            "fallback": [
              {
                "css": "h3.title"
              },
              {
                "css": "div.title"
              },
              {
                "css": "td.book-name a"
              }
            ]
          },
          "url": {
            "fallback": [
              {
                "xpath": "@href",
                "attr": "href"
              },
              {
                "css": "td.book-name a",
                "attr": "href"
              },
              {
                "css": "a",
                "attr": "href"
              }
            ]
          },
          "cover": {
            "css": "img.book-cover-img",
            "attr": "src",
            "placeholder": "5cb03bd"
          },
          "author": {
            "fallback": [
              {
                "css": "h4.author"
              },
              {
                "css": "div.author"
              },
              {
                "css": "td.author-name a"
              }
            ]
          }
        },
        "cover_state": {
          "lists": [
            "home.boyList",
            "home.girlList",
            "rank.book_list"
          ],
          "cover_key": "thumbUri"
        }
      }
    },
    "search": {
      "base_url": "/search/{keyword}",
      "method": "GET",
      "render": "playwright",
      "paginator": {
        "url_template": "/search/{keyword}"
      },
      "item": {
        "root_selector": {
          "css": "a[href*='/page/']"
        },
"render_config": {
          "wait_for": "a[href*='/page/']",
          "wait_until": "networkidle",
          "timeout_ms": 30000,
          "extra_delay_ms": 3000,
          "response_pages": 3,
          "response_json_url": "/api/author/search/search_book/v1",
          "response_items": "data.search_book_data_list",
          "response_fields": {
            "title": "book_name",
            "author": "author",
            "cover": "thumb_url",
            "summary": "book_abstract",
            "url_template": "{base}/page/{book_id}"
          },
          "filter_keyword": false
        }
      }
    },
    "detail": {
      "url_pattern": "/page/(\\d+)",
      "fields": {
        "title": {
          "css": "h1"
        },
        "author": {
          "css": ".author-name-text"
        },
        "cover": {
          "css": "img.book-cover-img",
          "attr": "src",
          "placeholder": "5cb03bd",
          "regex": "\"image\":\\[\"(https://[^\\\"]+)\"\\]",
          "state": "page.thumbUri"
        },
        "summary": {
          "css": ".page-abstract-content"
        },
        "status": {
          "css": ".info-label-yellow"
        },
        "tags": {
          "css": ".info-label-grey"
        }
      }
    },
    "content": {
      "chapter": {
        "pagination": {
          "enabled": true,
          "max_pages": 1
        },
        "list": {
          "root_selector": {
            "css": "div.chapter-item"
          },
          "fields": {
            "title": {
              "css": "a.chapter-item-title"
            },
            "url": {
              "css": "a.chapter-item-title",
              "attr": "href"
            }
          }
        },
        "body": {
          "selector": {
            "css": ".muye-reader-content p"
          }
        }
      }
    }
  },
  "constraints": {
    "search": {
      "max_pages": 1,
      "max_results": 30
    },
    "detail": {
      "max_pages": 1
    },
    "chapter": {
      "max_pages": 1,
      "max_items": 2000
    }
  },
  "decryption": {
    "targets": {
      "chapter": {
        "strategy": "translit"
      },
      "title": {
        "strategy": "translit"
      },
      "author": {
        "strategy": "translit"
      }
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "off"
    }
  },
  "api_endpoints": {
    "discovery": {
      "url": "/api/rank/category/list",
      "method": "GET",
      "params": {
        "app_id": 2503,
        "rank_list_type": 3,
        "offset": "{offset}",
        "limit": 10,
        "category_id": "{category_id}",
        "rank_version": "",
        "gender": "{gender}",
        "rankMold": "{rankMold}"
      },
      "response_path": "data.book_list",
      "item_fields": {
        "title": "bookName",
        "url": "/page/{bookId}",
        "cover": "thumbUri",
        "author": "author"
      }
    }
  }
