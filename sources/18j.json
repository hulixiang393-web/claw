{
  "$schema_version": 2,
  "$id": "18j",
  "$type": "video",
  "$name": "18J.TV",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://18j.tv",
    "description": "18J.TV - 成人视频站（HLS m3u8 直连）",
    "lang": "zh-CN",
    "region": "cn",
    "tags": [
      "视频",
      "成人",
      "免费",
      "hls"
    ]
  },
  "transports": {
    "base_url": "https://18j.tv",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9",
      "Referer": "https://18j.tv/"
    },
    "timeout": 10,
    "retries": 2,
    "interval_ms": 500,
    "follow_redirects": true,
    "retry_backoff": {
      "base_sec": 0.0,
      "max_sec": 0.0,
      "jitter": 0.0
    }
  },
  "endpoints": {
    "discovery": {
      "list_url": "/label/hot/by/time/",
      "list_paginator": {
        "type": "increment",
        "start": 1,
        "step": 1,
        "param": "page"
      },
      "list_item": {
        "categories": [
          {
            "title": "全部",
            "url": "/label/hot/by/time/"
          },
          {
            "title": "国产",
            "url": "/t/1/"
          },
          {
            "title": "日韩",
            "url": "/t/2/"
          },
          {
            "title": "欧美",
            "url": "/t/3/"
          },
          {
            "title": "伦理",
            "url": "/t/4/"
          },
          {
            "title": "成人AI",
            "url": "/t/41/"
          },
          {
            "title": "动漫",
            "url": "/t/5/"
          },
          {
            "title": "另类",
            "url": "/t/6/"
          }
        ]
      },
      "works_list_item": {
        "root_selector": {
          "css": "div.box"
        },
        "fields": {
          "title": {
            "css": "a[href*='/v/']",
            "attr": "title"
          },
          "url": {
            "css": "a[href*='/v/']",
            "attr": "href"
          },
          "cover": {
            "css": "img",
            "attr": "data-original"
          }
        }
      }
    },
    "search": {
      "base_url": "/vod/",
      "method": "GET",
      "keyword_param": "wd",
      "paginator": {
        "url_template": "/s/page/{page}/wd/{keyword}/"
      },
      "item": {
        "root_selector": {
          "css": "div.box"
        },
        "fields": {
          "title": {
            "css": "a[href*='/v/']",
            "attr": "title"
          },
          "url": {
            "css": "a[href*='/v/']",
            "attr": "href"
          },
          "cover": {
            "css": "img",
            "attr": "data-original"
          }
        }
      }
    },
    "detail": {
      "fields": {
        "title": {
          "css": "h1"
        },
        "summary": {
          "css": "meta[name='description']",
          "attr": "content"
        }
      }
    },
    "content": {
      "episode": {
        "single_chapter": true,
        "note": "详情页即播放页（内嵌 const source='...m3u8' 直链），无分集列表；单集结构直接用详情 URL 作为唯一章节，play_url.regex 提取 m3u8。",
        "play_url": {
          "regex": "(https?://[^\"'\\s]*m3u8[^\"'\\s]*)"
        },
        "list": {}
      }
    }
  },
  "constraints": {
    "search": {
      "max_pages": 50,
      "max_results": 1000
    },
    "detail": {
      "max_pages": 1,
      "timeout_per_page_sec": 30
    },
    "episode": {
      "max_pages": 1,
      "max_items": 1
    },
    "max_concurrency": 8,
    "global": {
      "total_timeout_sec": 600
    }
  },
  "ad_block": {
    "enabled": true,
    "block_url_regex": [
      "/stream/"
    ]
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "off"
    }
  },
  "media": {
    "format": "hls",
    "select": {
      "video": {
        "quality": "best"
      }
    },
    "merge": {}
  },
  "auth": {
    "login_required": false
  }
}