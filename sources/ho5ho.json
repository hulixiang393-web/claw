      "works_list_item": {
        "root_selector": {
          "css": "article.ho5ho-v2-card"
        },
        "fields": {
          "title": {
            "css": "h3.ho5ho-v2-card-title a"
          },
          "url": {
            "css": "a.ho5ho-v2-card-cover",
            "attr": "href"
          },
          "cover": {
            "css": "img.ho5ho-v2-card-image",
            "attr": "src"
          }
        }
      }
    },
    "search": {
      "base_url": "/",
      "method": "GET",
      "keyword_param": "s",
      "item": {
        "root_selector": {
          "css": "article.ho5ho-v2-card"
        },
        "fields": {
          "title": {
            "css": "h3.ho5ho-v2-card-title a"
          },
          "url": {
            "css": "a.ho5ho-v2-card-cover",
            "attr": "href"
          },
          "cover": {
            "css": "img.ho5ho-v2-card-image",
            "attr": "src"
          }
        }
      }
    },
    "detail": {
      "fields": {
        "title": {
          "css": "h1",
          "fallback": [
            {
              "css": "h1"
            },
            {
              "css": "meta[property='og:title']",
              "attr": "content"
            }
          ]
        },
        "cover": {
          "css": "img.attachment-medium.size-medium.skip-lazy",
          "attr": "src",
          "url_replace": [
            "(.+)-\\d+x\\d+\\.x32686\\.jpg",
            "{1}.jpg"
          ]
        },
        "summary": {
          "css": "meta[name='description']",
          "attr": "content"
        },
        "tags": {
          "css": "a[href*='h漫分類'], a[href*='h漫標籤']"
        }
      }
    },
    "content": {
      "page": {
        "list": {
          "root_selector": {
            "css": "a.ho5ho-v3-read-button"
          },
          "fields": {
            "title": {
              "css": "span.ho5ho-v3-read-button-copy strong"
            },
            "url": {
              "css": "a.ho5ho-v3-read-button",
              "attr": "href"
            }
          }
        },
        "body": {
          "root_selector": {
            "css": "img.wp-manga-chapter-img"
          },
          "fields": {
            "url": {
              "css": "img.wp-manga-chapter-img",
              "attr": "src",
              "fallback": [
                {
                  "css": "img.wp-manga-chapter-img",
                  "attr": "src"
                },
                {
                  "css": "img.wp-manga-chapter-img",
                  "attr": "data-src"
                }
              ]
            }
          },
          "paginator": {
            "next_link": {
              "selector": {
                "css": "a.next_page",
                "attr": "href"
              }
            },
            "max_pages": 80
          }
        }
      }
    }
  },
  "constraints": {
    "search": {
      "max_pages": 1,
      "max_results": 60
    },
    "detail": {
      "max_pages": 1
    },
    "page": {
      "max_pages": 80
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "off"
    }
  }
}