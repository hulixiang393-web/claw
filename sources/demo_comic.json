{
  "$schema_version": 2,
  "$id": "demo_comic",
  "$type": "comic",
  "$name": "演示漫画站",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://example.com/comic",
    "description": "演示用漫画源",
    "lang": "zh-CN",
    "tags": ["日更"]
  },
  "transports": {
    "base_url": "https://example.com/comic",
    "timeout": 10,
    "retries": 3,
    "interval_ms": 500
  },
  "endpoints": {
    "discovery": {
      "list_url": "/category",
      "list_item": {
        "root_selector": { "css": ".cat-item" },
        "fields": {
          "title": { "css": ".cat-name" },
          "url": { "css": "a", "attr": "href" }
        }
      }
    },
    "search": {
      "base_url": "/search",
      "method": "GET",
      "item": {
        "root_selector": { "css": ".book-item" },
        "fields": {
          "title": { "css": "a.title" },
          "url": { "css": "a.title", "attr": "href" }
        }
      }
    }
  },
  "constraints": {
    "search": { "max_pages": 3, "max_results": 20 }
  }
}
