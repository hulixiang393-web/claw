          { "id": "xinlang", "name": "新浪资源", "baseUrl": "https://api.xinlangapi.com", "searchPath": "/xinlangapi.php/provide/vod", "detailPath": "/xinlangapi.php/provide/vod", "group": "normal", "enabled": true, "priority": 7 },
