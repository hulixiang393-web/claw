          { "id": "huya", "name": "虎牙资源", "baseUrl": "https://www.huyaapi.com", "searchPath": "/api.php/provide/vod", "detailPath": "/api.php/provide/vod", "group": "normal", "enabled": true, "priority": 15 },
          { "id": "ruyi", "name": "如意资源", "baseUrl": "https://cj.rycjapi.com", "searchPath": "/api.php/provide/vod", "detailPath": "/api.php/provide/vod", "group": "normal", "enabled": true, "priority": 16 },
