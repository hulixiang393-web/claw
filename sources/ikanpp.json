          { "id": "ikun", "name": "iKun资源", "baseUrl": "https://ikunzyapi.com", "searchPath": "/api.php/provide/vod", "detailPath": "/api.php/provide/vod", "group": "normal", "enabled": true, "priority": 20 },
          { "id": "lezi", "name": "乐子资源", "baseUrl": "https://cj.lziapi.com", "searchPath": "/api.php/provide/vod", "detailPath": "/api.php/provide/vod", "group": "normal", "enabled": true, "priority": 21 },
          { "id": "hongniu", "name": "红牛资源", "baseUrl": "https://www.hongniuzy2.com", "searchPath": "/api.php/provide/vod", "detailPath": "/api.php/provide/vod", "group": "normal", "enabled": true, "priority": 22 },
          { "id": "jingyu", "name": "鲸鱼资源", "baseUrl": "https://jyzyapi.com", "searchPath": "/provide/vod", "detailPath": "/provide/vod", "group": "normal", "enabled": true, "priority": 23 },
          { "id": "moduys", "name": "魔都影视", "baseUrl": "https://www.moduzy.com", "searchPath": "/api.php/provide/vod", "detailPath": "/api.php/provide/vod", "group": "normal", "enabled": true, "priority": 24 },
          { "id": "modu_dm", "name": "魔都动漫", "baseUrl": "https://caiji.moduapi.cc", "searchPath": "/api.php/provide/vod", "detailPath": "/api.php/provide/vod", "group": "normal", "enabled": true, "priority": 25 }
        ],
        "page": "{page}"
      },
      "item_fields": {
        "title": "vod_name",
        "url": "/title/{vod_id}?title={vod_name}&source={source}",
        "cover": "vod_pic",
        "author": "vod_area",
        "update": "vod_remarks"
      }
    },
    "detail": {
      "url": "/api/detail",
      "method": "POST",
      "body": {
        "id": "{id}",
        "source": "{source}",
        "title": "{title}"
      },
      "field_extractors": {
        "title": "vod_name",
        "cover": "vod_pic",
        "status": "vod_remarks",
        "summary": "vod_content",
        "actor": "vod_actor",
        "author": "vod_director",
        "tags": "type_name"
      },
      "chapters": {
        "items": "episodes",
        "title": "name",
        "number": "index",
        "url_template": "{url}"
      }
    }
  },
  "media": {
    "format": "hls",
    "select": {
      "video": {
        "quality": "best"
      }
    },
    "merge": {
      "tool": "ffmpeg",
      "output_format": "mp4"
    },
    "hls": {
      "workers": 4,
      "network_caching_ms": 30000
    }
  },
  "constraints": {
    "search": {
      "max_pages": 1,
      "max_results": 60
    },
    "detail": {
      "max_pages": 1
    },
    "episode": {
      "max_pages": 1,
      "max_items": 100
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "off"
    }
  }
}