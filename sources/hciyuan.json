{
  "$schema_version": 2,
  "$id": "hciyuan",
  "$type": "video",
  "$name": "H次元(h-ciyuan)",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://h-ciyuan.com/",
    "description": "H次元 - 里番系列合集/动画视频（WordPress，合集文章=帖子分页，视频为 voe.sx iframe 嵌入）",
    "lang": "zh-CN",
    "region": "cn",
    "tags": [
      "视频",
      "动画",
      "里番",
      "成人"
    ]
  },
  "transports": {
    "base_url": "https://h-ciyuan.com",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Referer": "https://h-ciyuan.com/"
    },
    "timeout": 15,
    "retries": 3,
    "interval_ms": 800
  },
  "endpoints": {
    "discovery": {
      "list_url": "/category/里番系列合集/page/{page}",
      "list_paginator": {
        "type": "increment",
        "start": 1,
        "step": 1
      },
      "list_item": {
        "categories": [
          {
            "title": "里番",
            "url": "/category/里番/page/{page}"
          },
          {
            "title": "游戏",
            "url": "/category/r18_game/page/{page}"
          },
          {
            "title": "里番系列合集",
            "url": "/category/里番系列合集/page/{page}"
          },
          {
            "title": "同人动画",
            "url": "/category/同人动画/page/{page}"
          },
          {
            "title": "Flash小游戏",
            "url": "/category/flash/page/{page}"
          },
          {
            "title": "漫画",
            "url": "/category/漫画/page/{page}"
          }
        ]
      },
      "works_list_item": {
        "root_selector": {
          "css": "#gridview-posts-wrapper .gridview-grid-post"
        },
        "fields": {
          "title": {
            "css": ".gridview-grid-post-title a"
          },
          "url": {
            "css": "a.gridview-grid-post-thumbnail-link",
            "attr": "href"
          },
          "cover": {
            "css": "img.gridview-grid-post-thumbnail-img",
            "attr": "data-src"
          },
          "update": {
            "css": ".gridview-grid-post-date"
          }
        }
      }
    },
    "search": {
      "base_url": "/",
      "method": "GET",
      "keyword_param": "s",
      "paginator": {
        "url_template": "/page/{page}/?s={keyword}"
      },
      "item": {
        "root_selector": {
          "css": "#gridview-posts-wrapper .gridview-grid-post"
        },
        "fields": {
          "title": {
            "css": ".gridview-grid-post-title a"
          },
          "url": {
            "css": "a.gridview-grid-post-thumbnail-link",
            "attr": "href"
          },
          "cover": {
            "css": "img.gridview-grid-post-thumbnail-img",
            "attr": "data-src"
          }
        }
      }
    },
    "detail": {
      "url_pattern": "/\\d{4}/\\d{2}/",
      "fields": {
        "title": {
          "css": "header.entry-header h1"
        },
        "cover": {
          "fallback": [
            {
              "css": "meta[property='og:image']",
              "attr": "content"
            },
            {
              "css": ".entry-content img:first-child",
              "attr": "src"
            }
          ]
        },
        "summary": {
          "css": ".entry-content p"
        },
        "tags": {
          "css": ".entry-content a[href*='/tag/']"
        }
      }
    },
    "content": {
      "episode": {
"list": {
                    "first_page_is_current": true,
                    "root_selector": {
                        "css": "div.page-links a.post-page-numbers"
                    },
                    "chapter_order": "asc",
                    "fields": {
                        "title": {
                            "css": "a.post-page-numbers"
                        },
                        "url": {
                            "css": "a.post-page-numbers",
                            "attr": "href"
                        }
                    }
                },
        "play_url": {
          "render": "playwright"
        },
        "render_config": {
          "wait_until": "domcontentloaded",
          "timeout_ms": 50000,
          "extra_delay_ms": 2000
        }
      }
    }
  },
  "constraints": {
    "search": {
      "max_pages": 8,
      "max_results": 160
    },
    "detail": {
      "max_pages": 1
    },
    "episode": {
      "max_pages": 1,
      "max_items": 50
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "soft",
      "selector": {
        "css": "#gridview-posts-wrapper .gridview-grid-post"
      }
    }
  }
}