    "description": "5238動漫 - WordPress 站，成人動漫影片在線播放。播放地址提取链：详情页内嵌 iframe player5238G.php（video.520cc.cc）→ 播放页 JS 内 get3G.php?mp4=0 → 响应 var ccsJsCmds 为 Caesar 移位4 + URL 编码的 JS，解码后含 <video><source src=\"...m3u8\">。视频为 HLS m3u8（CDN vs02aa.520cc.cc / surecdn.cc，分片/key 均无防盗链，实测 200）。取流走 play_url.http_chain 纯 HTTP（不依赖 Playwright），秒级完成。源 discovery/search/detail 均正常。",
    "lang": "zh-TW",
    "region": "tw",
    "tags": [
      "视频",
      "成人",
      "裏番",
      "動漫",
      "hls"
    ],
    "last_verified": "2026-08-11"
  },
  "transports": {
    "base_url": "https://www.5238.me",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-TW,zh;q=0.9,en;q=0.8",
      "Referer": "https://www.5238.me/"
    },
    "timeout": 15,
    "retries": 3,
    "interval_ms": 800,
    "charset": "utf-8"
  },
  "endpoints": {
    "discovery": {
      "list_url": "/page/1",
      "list_paginator": {
        "type": "increment",
        "start": 1,
        "step": 1,
        "page_placeholder": "\\d+$"
      },
      "list_item": {
        "categories": [
          {
            "title": "最新影片",
            "url": "/page/1"
          },
          {
            "title": "有碼",
            "url": "/category/%e6%9c%89%e7%a2%bc/page/1"
          },
          {
            "title": "無碼",
            "url": "/category/%e7%84%a1%e7%a2%bc/page/1"
          },
          {
            "title": "不分類",
            "url": "/category/%e4%b8%8d%e5%88%86%e9%a1%9e/page/1"
          },
          {
            "title": "最多人看",
            "url": "/page/1?order=views"
          }
        ]
      },
      "works_list_item": {
        "root_selector": {
          "css": "li.thumi"
        },
        "fields": {
          "title": {
            "css": "a.title"
          },
          "url": {
            "css": "a.title",
            "attr": "href"
          },
          "cover": {
            "css": "img",
            "attr": "src"
          }
        }
      }
    },
    "search": {
      "base_url": "/",
      "method": "GET",
      "keyword_param": "s",
      "item": {
        "root_selector": {
          "css": "li.thumi"
        },
        "fields": {
          "title": {
            "css": "a.title"
          },
          "url": {
            "css": "a.title",
            "attr": "href"
          },
          "cover": {
            "css": "img",
            "attr": "src"
          }
        }
      }
    },
    "detail": {
      "url_pattern": "/[^/]+\\.html",
      "fields": {
        "title": {
          "css": "h1"
        },
        "cover": {
          "regex": "https?://[^\"'\\s]+/wp-content/uploads/\\d{4}/\\d{2}/\\d{6}\\.jpg"
        }
      }
    },
    "content": {
      "episode": {
        "single_chapter": true,
        "note": "详情页即播放页。播放地址链：详情页内嵌 iframe player5238G.php（video.520cc.cc）→ 播放页 JS 内 get3G.php?mp4=0 → 响应 var ccsJsCmds 为 Caesar 移位+URL 编码的 JS，解码后含 <video><source src=...m3u8>。用 play_url.http_chain 纯 HTTP 秒级取流（不依赖 Playwright）。",
        "play_url": {
          "http_chain": [
            {
              "name": "iframe",
              "regex": "<iframe[^>]*src=[\"']([^\"']*player5238G\\.php[^\"']*)[\"']",
              "referer": "episode"
            },
            {
              "name": "get3g",
              "regex": "get3G\\.php\\?[^\"']+",
              "referer": "iframe",
              "force_mp4_0": true
            },
            {
              "name": "ccs",
              "regex": "var ccsJsCmds\\s*=\\s*'((?:[^'\\\\]|\\\\.)*)'",
              "referer": "get3g",
              "decode": "caesar_unquote"
            },
            {
              "regex": "<source[^>]*src=\"([^\"]+)\"",
              "referer": "get3g"
            }
          ]
        }
      }
    }
  },
  "media": {
    "format": "hls",
    "select": {
      "video": {
        "quality": "best"
      }
    },
    "merge": {
      "tool": "ffmpeg",
      "output_format": "mp4"
    },
    "hls": {
      "workers": 4
    }
  },
  "constraints": {
    "search": {
      "max_pages": 1,
      "max_results": 24
    },
    "detail": {
      "max_pages": 1
    },
    "episode": {
      "max_pages": 1,
      "max_items": 1
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "soft",
      "selector": {
        "css": "li.thumi"
      },
      "interval_hours": 24
    }
  }
}
