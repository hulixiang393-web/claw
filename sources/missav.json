    "charset": "utf-8",
    "follow_redirects": true,
    "cookie": "user_uuid=fb8e0d5b-9d77-4723-a9a6-13dbfe136b65; _ga=GA1.1.2060417865.1786006079; search_history=[%22%25E6%25A1%2583%25E4%25B9%2583%25E6%259C%25A8%25E9%25A6%2599%22]; _ga_9FFNX13PHD=GS2.1.s1786159656$o4$g1$t1786159666$j50$l0$h0; _ga_WVQPWV98M1=GS2.1.s1786159656$o4$g1$t1786159666$j50$l0$h0; cf_clearance=cKazM0RJY70hpCzf0s3TK.o4OG6spFvzwVOI4XzBUwo-1786254214-1.2.1.1-ZzMUEAfyEqp7a8GKFDdlwm93CXg_wM68m7EBqVZ3DaNEK1nJNMXD_McasUr3svL4WAj0uF7gTUSlKyOruHQoKcPAfrXfj.dnLGRc51Mng_GMRHTem3HDI1SDWt3HKKj3NMa9inrG3dRbqvo5VUD8aA70rltlKDuZse66n0cPqbI1AlwabbFXxFXrJS1fO0yWs0aKhvMeqxe5VPI.DtbXVsgQ1WCcW.YXZk5o6HPlnqi6XkXxDVH1vDNNNtG2FzDqZcxKICQU.9peWAfsrOEvYuj4xhoz5mnBdQmyOt6YWiEI9oPX6TS3B6IW99O3fxwjXtn.7XtDJQiH_Q.dd_4ciBK_0Cvtfj7UDcGY9frtE7B4iB5lmb.MKiLovbQ8zdNIBpQlT3tjyNSQYxIfwAP84FKS3v8wCzCBDjCukHkGaOEuDfsAeiF1MqLMNqk_HYoqPhQ5kfHVNfbHFW.ihCURyTlcsjQAg4.4iI8r2Is01zyXy7tySiHRUC4PVVSy.eIKk7xoXy4ZMQI549reUmVltw"
  },
  "endpoints": {
    "discovery": {
      "list_url": "/ja/new",
      "list_paginator": {
        "type": "increment",
        "start": 1,
        "step": 1
      },
      "list_item": {
        "categories": [
          {
            "title": "最新作品",
            "url": "/ja/new?page={page}"
          },
          {
            "title": "首页推荐",
            "url": "/dm285/ja?page={page}"
          },
          {
            "title": "每周热门",
            "url": "/ja/weekly-hot?page={page}"
          },
          {
            "title": "今日热门",
            "url": "/ja/today-hot?page={page}"
          },
          {
            "title": "每月热门",
            "url": "/ja/monthly-hot?page={page}"
          },
          {
            "title": "英文字幕",
            "url": "/ja/english-subtitle?page={page}"
          },
          {
            "title": "无码流出",
            "url": "/ja/uncensored-leak?page={page}"
          },
          {
            "title": "TWAV",
            "url": "/ja/twav?page={page}"
          },
          {
            "title": "HEYZO",
            "url": "/ja/heyzo?page={page}"
          },
          {
            "title": "FC2",
            "url": "/ja/fc2?page={page}"
          }
        ]
      },
      "works_list_item": {
        "root_selector": {
          "css": "div.thumbnail.group"
        },
        "fields": {
          "title": {
            "css": ".my-2.text-sm.text-nord4.truncate a"
          },
          "url": {
            "css": "a[href*='/ja/']",
            "attr": "href"
          },
          "cover": {
            "css": "img.lozad",
            "attr": "data-src"
          }
        }
      }
    },
    "search": {
      "base_url": "/ja/search/{keyword}",
      "method": "GET",
      "keyword_param": "keyword",
      "paginator": {
        "url_template": "/ja/search/{keyword}?page={page}"
      },
      "item": {
        "root_selector": {
          "css": "div.thumbnail.group"
        },
        "fields": {
          "title": {
            "css": ".my-2.text-sm.text-nord4.truncate a"
          },
          "url": {
            "css": "a[href*='/ja/']",
            "attr": "href"
          },
          "cover": {
            "css": "img.lozad",
            "attr": "data-src"
          }
        }
      }
    },
    "detail": {
      "url_pattern": "(?:/ja/|/dm\\d+/ja/)[a-z0-9-]+",
      "fields": {
        "title": {
          "css": "meta[property='og:title']"
        },
        "cover": {
          "css": "meta[property='og:image']"
        },
        "summary": {
          "css": "meta[property='og:description']"
        },
        "status": {
          "css": "meta[property='og:video:duration']",
          "attr": "content"
        },
        "meta": {
          "release_date": {
            "css": "meta[property='og:video:release_date']",
            "attr": "content"
          }
        }
      }
    },
    "content": {
      "episode": {
        "single_chapter": true,
        "play_url": {
          "regex": "https:\\\\/\\\\/[a-z0-9.-]+\\\\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\\\/",
          "suffix": "/playlist.m3u8"
        },
        "list": {
          "fields": {}
        }
      }
    }
  },
  "media": {
    "format": "hls",
    "select": {
      "video": {
        "quality": "best"
      }
    },
    "merge": {
      "tool": "ffmpeg",
      "output_format": "mp4"
    },
    "hls": {
      "workers": 4
    }
  },
  "constraints": {
    "search": {
      "max_pages": 5,
      "max_results": 60
    },
    "detail": {
      "max_pages": 1,
      "timeout_per_page_sec": 20
    },
    "episode": {
      "max_pages": 1,
      "max_items": 1
    },
    "max_concurrency": 2,
    "global": {
      "total_timeout_sec": 3600
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "soft",
      "selector": {
        "css": "div.thumbnail.group"
      }
    }
  },
  "ad_block": {
    "enabled": true
  }
}