{
  "$schema_version": 2,
  "$id": "dm84",
  "$type": "video",
  "$name": "动漫巴士（dm84）",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://dm84.tv/",
    "description": "动漫巴士：国漫、日漫、欧美动漫与动漫电影",
    "lang": "zh-CN",
    "region": "cn",
    "tags": ["视频", "动漫", "国漫", "日漫", "欧美动漫", "HLS"]
  },
  "transports": {
    "base_url": "https://dm84.tv",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9",
      "Referer": "https://dm84.tv/"
    },
    "timeout": 20,
    "retries": 2,
    "interval_ms": 800,
    "follow_redirects": true
  },
  "endpoints": {
    "discovery": {
      "list_url": "/",
      "list_paginator": {"type": "increment", "start": 1, "step": 1, "param": "page"},
      "list_item": {
        "categories": [
          {"title": "全部", "url": "/"},
          {"title": "国漫", "url": "/list-1-{page}.html"},
          {"title": "日漫", "url": "/list-2-{page}.html"},
          {"title": "欧美动漫", "url": "/list-3-{page}.html"},
          {"title": "电影", "url": "/list-4-{page}.html"},
          {"title": "科幻", "url": "/s-----%E7%A7%91%E5%B9%BB-----{page}.html"},
          {"title": "战斗", "url": "/s-----%E6%88%98%E6%96%97-----{page}.html"},
          {"title": "奇幻", "url": "/s-----%E5%A5%87%E5%B9%BB-----{page}.html"},
          {"title": "热血", "url": "/s-----%E7%83%AD%E8%A1%80-----{page}.html"},
          {"title": "后宫", "url": "/s-----%E5%90%8E%E5%AE%AB-----{page}.html"},
          {"title": "校园", "url": "/s-----%E6%A0%A1%E5%9B%AD-----{page}.html"},
          {"title": "武侠", "url": "/s-----%E6%AD%A6%E4%BE%A0-----{page}.html"},
          {"title": "搞笑", "url": "/s-----%E6%90%9E%E7%AC%91-----{page}.html"}
        ]
      },
      "works_list_item": {
        "root_selector": {"xpath": "//li[div[contains(concat(' ',normalize-space(@class),' '),' item ')]]"},
        "fields": {
          "title": {"css": "a.title", "attr": "title"},
          "url": {"css": "a.title", "attr": "href"},
          "cover": {"css": "a.cover", "attr": "data-bg"},
          "update": {"css": "span.desc"}
        }
      }
    },
    "search": {
      "base_url": "/",
      "method": "GET",
      "keyword_param": "wd",
      "paginator": {"url_template": "/s----------.html?wd={keyword}"},
      "item": {
        "root_selector": {"xpath": "//li[div[contains(concat(' ',normalize-space(@class),' '),' item ')]]"},
        "fields": {
          "title": {"css": "a.title", "attr": "title"},
          "url": {"css": "a.title", "attr": "href"},
          "cover": {"css": "a.cover", "attr": "data-bg"},
          "update": {"css": "span.desc"}
        }
      }
    },
    "detail": {
      "url_pattern": "/v/\\d+\\.html",
      "fields": {
        "title": {"css": "h1"},
        "cover": {"css": "meta[property='og:image']", "attr": "content"},
        "summary": {"css": "#intro", "regex": "剧情：([\\s\\S]*)"},
        "author": {"css": "#intro p:first-child", "regex": "导演：(.*)"},
        "actor": {"xpath": "//*[@id='intro']/p[2]", "regex": "主演：(.*)"},
        "tags": {"css": "p.v_desc a[href*='show-']"}
      }
    },
    "content": {
      "episode": {
        "list": {
          "root_selector": {"css": "ul.play_list li"},
          "fields": {"title": {"css": "a"}, "url": {"css": "a", "attr": "href"}}
        },
        "play_url": {
          "render": "playwright",
          "selector": {"css": "iframe[name='tv'], iframe[src*='hhjx.hhplayer.com']", "attr": "src"}
        },
        "render_config": {"wait_until": "domcontentloaded", "extra_delay_ms": 2500, "timeout_ms": 45000}
      }
    }
  },
  "media": {"format": "hls", "select": {"video": {"quality": "best"}}, "hls": {"workers": 4}},
  "ad_block": {"enabled": true},
  "constraints": {"search": {"max_pages": 1, "max_results": 300}, "detail": {"max_pages": 1}, "episode": {"max_pages": 1, "max_items": 1000}, "max_concurrency": 2},
  "diagnostics": {"selfcheck": {"strategy": "soft", "selector": {"css": "a[href^='/v/']"}}}
}
