{
  "$schema_version": 2,
  "$id": "mrds66",
  "$type": "video",
  "$name": "每日大赛(mrds66)",
  "$enabled": false,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://www.mrds66.com/",
    "description": "每日大赛 - smdh(动漫之家)分类：成人动画图文+JS播放器源。注意：①强反爬（域名校验JS劫持DOM），静态抓取可能拿到残留页，启用前须实测；②真实视频地址需从播放器JS提取（未闭环）；③列表夹杂赌博广告外链。草稿源（$enabled=false）。",
    "lang": "zh-CN",
    "region": "cn",
    "tags": [
      "视频",
      "动画",
      "成人"
    ]
  },
  "transports": {
    "base_url": "https://www.mrds66.com",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Referer": "https://www.mrds66.com/"
    },
    "timeout": 15,
    "retries": 3,
    "interval_ms": 800
  },
  "endpoints": {
    "discovery": {
      "list_url": "/category/smdh/{page}",
      "list_paginator": {
        "type": "increment",
        "start": 1,
        "step": 1
      },
      "list_item": {
        "categories": [
          {
            "title": "动漫之家(smdh)",
            "url": "/category/smdh/{page}"
          }
        ]
      },
      "works_list_item": {
        "root_selector": {
          "css": "article"
        },
        "fields": {
          "title": {
            "css": "a[href*='/archives/'] h2"
          },
          "url": {
            "css": "a[href*='/archives/']",
            "attr": "href"
          },
          "update": {
            "css": "a[href*='/archives/'] time"
          }
        }
      }
    },
    "search": {
      "base_url": "/",
      "method": "GET",
      "keyword_param": "s",
      "paginator": {
        "url_template": "/page/{page}/?s={keyword}"
      },
      "item": {
        "root_selector": {
          "css": "article"
        },
        "fields": {
          "title": {
            "css": "a[href*='/archives/'] h2"
          },
          "url": {
            "css": "a[href*='/archives/']",
            "attr": "href"
          }
        }
      }
    },
    "detail": {
      "url_pattern": "/archives/\\d+",
      "fields": {
        "title": {
          "css": "article h1"
        },
        "author": {
          "css": "article a[href*='/author/']"
        },
        "cover": {
          "css": "article p img:first-child",
          "attr": "src"
        },
        "summary": {
          "css": "article p"
        },
        "status": {
          "css": "article time"
        },
        "tags": {
          "css": "article a[href*='/tag/']"
        }
      }
    },
    "content": {
      "episode": {
        "single_chapter": true,
        "note": "本分类文章为图文混排+JS视频播放器，无分集列表。真实视频地址需从播放器 JS 变量/接口提取，已尝试 regex 兜底；如站点结构不匹配需二次调研播放器取流。",
        "play_url": {
          "regex": "(?:url|url_high|playurl|src)[\"'\\s]*[:=][\"'\\s]*([^\"']+?\\.(?:m3u8|mp4)[^\"']*)[\"']"
        }
      }
    }
  },
  "constraints": {
    "search": {
      "max_pages": 1,
      "max_results": 30
    },
    "detail": {
      "max_pages": 1
    },
    "episode": {
      "max_pages": 1,
      "max_items": 1
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "off"
    }
  }
}