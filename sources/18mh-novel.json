{
  "$schema_version": 2,
  "$id": "18mh-novel",
  "$type": "novel",
  "$name": "禁漫小说(18mh)",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://18mh.net",
    "description": "禁漫天堂 - 小说源（SPA 渲染正文）",
    "lang": "zh-CN",
    "region": "cn",
    "tags": ["小说", "成人", "免费", "render"]
  },
  "transports": {
    "base_url": "https://18mh.net",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9",
      "Referer": "https://18mh.net/"
    },
    "timeout": 20,
    "retries": 3,
    "interval_ms": 500
  },
  "endpoints": {
    "discovery": {
      "list_url": "/novel/all",
      "list_item": {
        "categories": [
          { "title": "全部小说", "url": "/novel/all" },
          { "title": "都市激情", "url": "/novel/all/dsjq" },
          { "title": "校园春色", "url": "/novel/all/xycs" },
          { "title": "乡村爱情", "url": "/novel/all/xcaq" },
          { "title": "系统异能", "url": "/novel/all/xtyn" },
          { "title": "家庭乱伦", "url": "/novel/all/jtll" },
          { "title": "穿越重生", "url": "/novel/all/cycs" },
          { "title": "经典武侠", "url": "/novel/all/jdwx" },
          { "title": "同人改编", "url": "/novel/all/trgb" },
          { "title": "科学幻想", "url": "/novel/all/kxhx" },
          { "title": "东方玄幻", "url": "/novel/all/dfxh" }
        ]
      },
      "works_list_item": {
        "root_selector": { "css": "ul.dx-novel-list li" },
        "fields": {
          "title": { "css": "h2" },
          "url": { "css": "a[href*='/novel/detail/']", "attr": "href" },
          "cover": { "css": "img", "attr": "data-src" }
        }
      }
    },
    "search": {
      "base_url": "/novel/all",
      "method": "GET",
      "keyword_param": "keyword",
      "item": {
        "root_selector": { "css": "ul.dx-novel-list li" },
        "fields": {
          "title": { "css": "h2" },
          "url": { "css": "a[href*='/novel/detail/']", "attr": "href" },
          "cover": { "css": "img", "attr": "data-src" }
        }
      }
    },
    "detail": {
      "fields": {
        "title": { "css": "h1" },
        "author": { "css": ".detail-page__meta-item--author" },
        "summary": { "css": "meta[name='description']", "attr": "content" },
        "status": { "css": ".detail-page__meta-item" }
      }
    },
    "content": {
      "chapter": {
        "list": {
          "root_selector": { "css": "a.detail-page__catalog-item" },
          "fields": {
            "title": { "css": ".detail-page__chapter-title" },
            "url": { "css": "a.detail-page__catalog-item", "attr": "href" }
          }
        },
        "body": {
          "render": "playwright",
          "render_config": {
            "wait_for": ".dx-container.app-content",
            "wait_until": "domcontentloaded",
            "extra_delay_ms": 2000,
            "timeout_ms": 30000
          },
          "selector": { "css": ".dx-container.app-content" }
        }
      }
    }
  },
  "constraints": {
    "search": { "max_pages": 1, "max_results": 48 },
    "detail": { "max_pages": 1 },
    "chapter": { "max_pages": 500, "max_items": 500 }
  },
  "decryption": {
    "targets": {
      "image": {
        "strategy": "aes_cbc",
        "key": "f5d965df75336270",
        "iv": "97b60394abc2fbe1",
        "padding": "none",
        "input": "bytes",
        "output": "bytes"
      }
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "off"
    }
  }
}
