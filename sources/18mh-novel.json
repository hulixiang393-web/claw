{
  "$schema_version": 2,
  "$id": "18mh-novel",
  "$type": "novel",
  "$name": "禁漫小说(18mh)",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "adult": true,
    "homepage": "https://18mh.net",
    "description": "禁漫天堂 - 小说源（jm-v4 版式，正文 SSR 直出）",
    "lang": "zh-CN",
    "region": "cn",
    "tags": [
      "小说",
      "成人",
      "免费",
      "render"
    ]
  },
  "transports": {
    "base_url": "https://18mh.net",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9",
      "Referer": "https://18mh.net/",
      "Upgrade-Insecure-Requests": "1",
      "Sec-Fetch-Site": "same-origin",
      "Sec-Fetch-Mode": "navigate",
      "Sec-Fetch-User": "?1",
      "Sec-Fetch-Dest": "document"
    },
    "timeout": 10,
    "retries": 2,
    "interval_ms": 500
  },
  "endpoints": {
    "discovery": {
      "list_url": "/novel/all",
      "note": "2026-10 站点换版为 jm-v4：旧版 ul.dx-novel-list 消失，小说列表改为 ul.jm-grid--book > li.jm-card（每页 20 张，封面 img.jm-card__img[data-src]，标题 h3.jm-card__title a，详情链接在 a.jm-card__cover 的 href）。",
      "list_item": {
        "categories": [
          {
            "title": "全部小说",
            "url": "/novel/all"
          },
          {
            "title": "都市激情",
            "url": "/novel/all/dsjq"
          },
          {
            "title": "校园春色",
            "url": "/novel/all/xycs"
          },
          {
            "title": "乡村爱情",
            "url": "/novel/all/xcaq"
          },
          {
            "title": "系统异能",
            "url": "/novel/all/xtyn"
          },
          {
            "title": "家庭乱伦",
            "url": "/novel/all/jtll"
          },
          {
            "title": "穿越重生",
            "url": "/novel/all/cycs"
          },
          {
            "title": "经典武侠",
            "url": "/novel/all/jdwx"
          },
          {
            "title": "同人改编",
            "url": "/novel/all/trgb"
          },
          {
            "title": "科学幻想",
            "url": "/novel/all/kxhx"
          },
          {
            "title": "历史架空",
            "url": "/novel/all/lsjk"
          },
          {
            "title": "西方魔幻",
            "url": "/novel/all/xfmh"
          },
          {
            "title": "仙侠修真",
            "url": "/novel/all/xzxs"
          },
          {
            "title": "娱乐明星",
            "url": "/novel/all/ylmx"
          },
          {
            "title": "东方玄幻",
            "url": "/novel/all/dfxh"
          }
        ]
      },
      "works_list_item": {
        "root_selector": {
            "css": "ul.jm-grid--book > li.jm-card"
        },
        "fields": {
          "title": {
            "css": "h3.jm-card__title a"
          },
          "url": {
            "css": "a.jm-card__cover",
            "attr": "href"
          },
          "cover": {
            "fallback": [
              {"css": "img.jm-card__img", "attr": "data-src"},
              {"css": "img.jm-card__img", "attr": "data-original"},
              {"css": "img.jm-card__img", "attr": "src"}
            ]
          }
        }
      }
    },
    "search": {
      "base_url": "/novel/search/{keyword}",
      "method": "GET",
      "keyword_param": "keyword",
      "note": "搜索结果改为 a.jm-rrow 行式条目（页内 pager 为 jm-sr-pg，分页 /novel/search/{kw}/page/{n} 与漫画/视频同构）。",
      "paginator": {
        "url_template": "/novel/search/{keyword}/page/{page}"
      },
      "item": {
        "root_selector": {
            "css": "a.jm-rrow"
        },
        "fields": {
          "title": {
            "css": ".jm-rrow__title"
          },
          "url": {
            "css": "a.jm-rrow",
            "attr": "href"
          },
          "cover": {
            "fallback": [
              {"css": "img.jm-rrow__img", "attr": "data-src"},
              {"css": "img.jm-rrow__img", "attr": "data-original"},
              {"css": "img.jm-rrow__img", "attr": "src"}
            ]
          }
        }
      }
    },
    "detail": {
      "fields": {
        "title": {
          "css": "h1.jm-dt-title"
        },
        "author": {
          "css": ".jm-dt-meta a[href*='/novel/all/author/']"
        },
        "cover": {
          "fallback": [
            {"css": "img.jm-dt-cover__img", "attr": "data-src"},
            {"css": "meta[property='og:image']", "attr": "content"}
          ]
        },
        "summary": {
          "css": "meta[name='description']",
          "attr": "content"
        },
        "status": {
          "css": ".jm-dt-pill--st"
        }
      },
      "note": "详情页标题从无 class 的 <h1> 变为 h1.jm-dt-title（漫画/小说共用同一套 jm-dt-* 版式）；简介仍取 meta[name=description]。"
    },
    "content": {
      "chapter": {
        "list": {
          "root_selector": {
            "css": ".jm-dt-chap a.jm-dt-ch"
          },
          "chapter_order": "asc",
          "title_clean": false,
          "note": "目录项 a.jm-dt-ch 里 span.jm-dt-ch__no 是『第N章』、span.jm-dt-ch__t 是章名，整串 text_content 会粘成『第1章协议』；旧配置用 .detail-page__catalog-left 一次取到含序号的串。新版取『第N章』+章名（css 逗号并列），名称由 describe_chapter 归一，章号供标题『第1章 协议』与窗口回退用。章节地址改为 /novel_chapter/{book_id}/{n}.html。",
          "fields": {
            "title": {
              "css": "span.jm-dt-ch__no, span.jm-dt-ch__t"
            },
            "url": {
              "css": "a.jm-dt-ch",
              "attr": "href"
            }
          }
        },
        "body": {
          "selector": {
            "css": ".jm-rd-text"
          },
          "note": "正文在 /novel_chapter/{id}/{n}.html，SSR 直出 p 段落（容器 .article.jm-rd-text[data-rd-text]，章节名 h2.jm-rd-ttl）；旧版 .dx-container.app-content 已不存在，也不再需要 Playwright 渲染。"
        }
      }
    }
  },
  "constraints": {
    "search": {
      "max_pages": 30,
      "max_results": 1440
    },
    "detail": {
      "max_pages": 1
    },
    "chapter": {
      "max_pages": 500,
      "max_items": 500
    }
  },
  "decryption": {
    "targets": {
      "image": {
        "strategy": "aes_cbc",
        "key": "f5d965df75336270",
        "iv": "97b60394abc2fbe1",
        "padding": "none",
        "input": "bytes",
        "output": "bytes"
      }
    }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "off"
    }
  }
}
