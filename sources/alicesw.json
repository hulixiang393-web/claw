        "clean": {
          "title": [
            [
              "re:^\\d+\\.\\s*",
              ""
            ]
          ]
        }
      },
      "paginator": {
        "url_template": "/search.html?q={keyword}&f=_all&sort=relevance&p={page}"
      }
    },
    "detail": {
      "url_pattern": "/novel/[\\d]+\\.html",
      "fields": {
        "title": {
          "css": "div.novel_title"
        },
        "cover": {
          "css": "img.lazyload_book_cover",
          "attr": "data-src"
        },
        "summary": {
          "css": "div.jianjie p"
        },
        "author": {
          "css": "div.novel_info p:first-child a"
        },
        "status": {
          "css": "div.novel_info p:nth-of-type(5)"
        },
        "tags": {
          "css": "div.tags_list a",
          "regex": "#?\\s*([^#\\s]+)"
        },
        "clean": {
          "status": [
            [
              "re:^状\\s*态[:：]\\s*",
              ""
            ]
          ]
        }
      }
    },
    "content": {
      "chapter": {
        "list": {
          "chapters_url": "/other/chapters/id/{id}.html",
          "root_selector": {
            "css": "ul.mulu_list li a[href*='/book/']"
          },
          "chapter_order": "asc",
          "fields": {
            "title": {
              "css": "a[href*='/book/']"
            },
            "url": {
              "css": "a[href*='/book/']",
              "attr": "href"
            }
          }
        },
        "body": {
          "selector": {
            "css": "div.read-content.j_readContent p"
          }
        }
      }
    }
  },
  "constraints": {
    "search": {
      "max_pages": 30,
      "max_results": 300
    },
    "detail": {
      "max_pages": 1
    },
    "chapter": {
      "max_pages": 100,
      "max_items": 500
    }
  },
  "diagnostics": {
    "selfcheck": {
