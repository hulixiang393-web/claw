{
  "$schema_version": 2,
  "$id": "rouvideo",
  "$type": "video",
  "$name": "Rou.video",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "adult": true,
    "homepage": "https://rou.video/home",
    "description": "Rou.video 视频源。SSR 页面列表、搜索、标签和详情均可通过 HTTP 解析，详情播放器数据使用页面内 Base64 字节移位 JSON 解密。",
    "lang": "zh-CN",
    "region": "cn",
    "tags": ["视频", "成人", "国产", "自拍", "探花", "HLS"]
  },
  "transports": {
    "base_url": "https://rou.video",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Referer": "https://rou.video/home",
      "Upgrade-Insecure-Requests": "1"
    },
    "timeout": 15,
    "retries": 2,
    "interval_ms": 300,
    "charset": "utf-8"
  },
  "endpoints": {
    "discovery": {
      "list_url": "/home",
      "list_item": {
        "categories": [
          {"title": "首页", "url": "/home"},
          {"title": "分类", "url": "/cat"},
          {"title": "國產AV", "url": "/t/%E5%9C%8B%E7%94%A2AV"},
          {"title": "探花", "url": "/t/%E6%8E%A2%E8%8A%B1"},
          {"title": "自拍流出", "url": "/t/%E8%87%AA%E6%8B%8D%E6%B5%81%E5%87%BA"}
        ]
      },
      "works_list_item": {
        "root_selector": {"css": "a[href^='/v/']"},
        "fields": {
          "title": {"css": "h3"},
          "url": {"xpath": "self::a", "attr": "href"},
          "cover": {"css": "img", "attr": "src"}
        }
      }
    },
    "search": {
      "base_url": "/search?q={keyword}",
      "method": "GET",
      "keyword_param": "q",
      "paginator": {
        "url_template": "/search?q={keyword}&page={page}"
      },
      "item": {
        "root_selector": {"css": "a[href^='/v/']"},
        "fields": {
          "title": {"css": "h3"},
          "url": {"xpath": "self::a", "attr": "href"},
          "cover": {"css": "img", "attr": "src"}
        }
      }
    },
    "detail": {
      "url_pattern": "/v/[A-Za-z0-9]+",
      "fields": {
        "title": {"css": "h1"},
        "cover": {"css": "video.rv-player-video", "attr": "poster"},
        "summary": {"css": "meta[name='description']", "attr": "content"},
        "tags": {"css": "a[href^='/t/']"}
      }
    },
    "content": {
      "episode": {
        "single_chapter": true,
        "note": "详情页即单个视频。SSR 的 ev:$R 数据需先 Base64 解码，再按页面同项 k 对每个字节减法移位，得到 JSON 后取 videoUrl；当前响应会动态变化，不能固定密钥。",
        "play_url": {
          "http_chain": [
            {
              "name": "payload",
              "regex": "ev:\\$R\\[\\d+\\]=\\{d:\"([^\"]+)\",k:\\d+\\}",
              "decode": "base64_shift_json",
              "shift_regex": "ev:\\$R\\[\\d+\\]=\\{d:\"[^\"]+\",k:(\\d+)\\}"
            },
            {
              "name": "hls",
              "regex": "\"videoUrl\"\\s*:\\s*\"([^\"]+)\"",
              "fetch": false
            }
          ]
        }
      }
    }
  },
  "media": {
    "format": "hls",
    "select": {"video": {"quality": "best"}},
    "merge": {"tool": "ffmpeg", "output_format": "mp4"}
  },
  "constraints": {
    "search": {"max_pages": 30, "max_results": 0},
    "detail": {"max_pages": 1},
    "episode": {"max_pages": 1, "max_items": 1}
  },
  "diagnostics": {
    "selfcheck": {"strategy": "soft", "selector": {"css": "a[href^='/v/'] h3"}}
  }
}
