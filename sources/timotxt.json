{
  "$schema_version": 2,
  "$id": "timotxt",
  "$type": "novel",
  "$name": "TimoTXT",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://www.timotxt.com/",
    "description": "TimoTXT 免费小说站。站点启用 Cloudflare 防护，发现、搜索、详情和正文统一使用 Playwright；正文繁体自动转换为简体。",
    "icon": "https://www.timotxt.com/favicon.ico",
    "lang": "zh-CN",
    "region": "tw",
    "tags": [
      "小说",
      "免费",
      "简体转换",
      "Playwright"
    ],
    "last_verified": "2026-10-12"
  },
  "transports": {
    "base_url": "https://www.timotxt.com",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.7",
      "Referer": "https://www.timotxt.com/"
    },
    "timeout": 30,
    "retries": 1,
    "interval_ms": 500,
    "follow_redirects": true
  },
  "endpoints": {
    "discovery": {
      "list_url": "/",
      "render": "playwright",
      "render_config": {
        "wait_for": "ul.flex.list > li",
        "wait_until": "domcontentloaded",
        "timeout_ms": 45000,
        "extra_delay_ms": 300
      },
      "list_item": {
        "categories": [
          { "title": "最新小说", "url": "/" }
        ]
      },
      "works_list_item": {
        "root_selector": {
          "css": "ul.flex.list > li"
        },
        "fields": {
          "title": {
            "css": "h3 a"
          },
          "url": {
            "css": "h3 a",
            "attr": "href"
          },
          "cover": {
            "fallback": [
              { "css": "img", "attr": "data-src" },
              { "css": "img", "attr": "data-original" },
              { "css": "img", "attr": "src" }
            ]
          },
          "author": {
            "css": "p.author"
          }
        }
      }
    },
    "search": {
      "base_url": "/",
      "method": "GET",
      "keyword_param": "keyword",
      "render": "playwright",
      "item": {
        "root_selector": {
          "css": "ul.flex.list > li"
        },
        "render_config": {
          "interact": true,
          "home_url": "https://www.timotxt.com/",
          "input_selector": "input[name='searchkey'], input[name='keyword'], input[type='search']",
          "wait_until": "domcontentloaded",
          "timeout_ms": 45000,
          "extra_delay_ms": 300,
          "filter_keyword": true
        }
      }
    },
    "detail": {
      "render": "playwright",
      "render_config": {
        "wait_for": "body#read, #chapterWarp",
        "wait_until": "domcontentloaded",
        "timeout_ms": 45000,
        "extra_delay_ms": 300
      },
      "fields": {
        "title": {
          "fallback": [
            { "css": "h1.book-title" },
            { "css": "h1.imgtext" },
            { "css": "title" }
          ]
        },
        "author": {
          "fallback": [
            { "css": "p.author" },
            { "css": ".author" }
          ]
        },
        "cover": {
          "fallback": [
            { "css": ".book-cover img", "attr": "src" },
            { "css": "meta[property='og:image']", "attr": "content" }
          ]
        },
        "summary": {
          "fallback": [
            { "css": ".book-intro" },
            { "css": "meta[name='description']", "attr": "content" }
          ]
        },
        "tags": {
          "css": ".tags a, .tag a"
        }
      }
    },
    "content": {
      "chapter": {
        "pagination": {
          "enabled": false
        },
        "list": {
          "chapter_order": "asc",
          "root_selector": {
            "css": "a[href$='.html']"
          },
          "fields": {
            "title": {
              "xpath": "."
            },
            "url": {
              "xpath": ".",
              "attr": "href"
            }
          }
        },
        "body": {
          "selector": {
            "css": "div.chapter-content div.content"
          },
          "render": "playwright",
          "render_config": {
            "wait_for": "body#read, #chapterWarp, div.chapter-content div.content",
            "wait_until": "domcontentloaded",
            "timeout_ms": 45000,
            "extra_delay_ms": 300
          }
        }
      }
    }
  },
  "constraints": {
    "search": { "max_pages": 1, "max_results": 30 },
    "detail": { "max_pages": 1 },
    "chapter": { "max_pages": 100, "max_items": 5000 }
  },
  "decryption": {
    "targets": {
      "title": { "strategy": "zh_convert", "to": "zh-cn" },
      "search_title": { "strategy": "zh_convert", "to": "zh-cn" },
      "author": { "strategy": "zh_convert", "to": "zh-cn" },
      "search_author": { "strategy": "zh_convert", "to": "zh-cn" },
      "chapter": { "strategy": "zh_convert", "to": "zh-cn" },
      "content": { "strategy": "zh_convert", "to": "zh-cn" },
      "summary": { "strategy": "zh_convert", "to": "zh-cn" }
    }
  },
  "diagnostics": {
    "selfcheck": { "strategy": "off" }
  }
}
