{
  "$schema_version": 2,
  "$id": "omofuna",
  "$type": "video",
  "$name": "Omofun动漫",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://www.omofuna.com/",
    "description": "Omofun动漫：日漫、国漫、动画、剧场、特摄、美漫，多线路分集播放",
    "lang": "zh-CN",
    "region": "cn",
    "tags": ["视频", "动漫", "日漫", "国漫", "剧场", "特摄", "美漫", "HLS"]
  },
  "transports": {
    "base_url": "https://www.omofuna.com",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Referer": "https://www.omofuna.com/"
    },
    "timeout": 6,
    "retries": 0,
    "interval_ms": 300,
    "follow_redirects": true
  },
  "endpoints": {
    "discovery": {
      "list_url": "/type/1-{page}.html",
      "list_paginator": {"type": "increment", "start": 1, "step": 1, "param": "page"},
      "list_item": {
        "categories": [
          {"title": "日漫", "url": "/type/1-{page}.html"},
          {"title": "国漫", "url": "/type/2-{page}.html"},
          {"title": "动画", "url": "/type/5-{page}.html"},
          {"title": "剧场", "url": "/type/24-{page}.html"},
          {"title": "特摄", "url": "/type/4-{page}.html"},
          {"title": "美漫", "url": "/type/3-{page}.html"}
        ]
      },
      "works_list_item": {
        "root_selector": {"css": "a[data-original][href^='/anime/']"},
        "fields": {
          "title": {"css": "a", "attr": "title"},
          "url": {"css": "a", "attr": "href"},
          "cover": {"css": "a", "attr": "data-original"}
        }
      }
    },
    "search": {
      "base_url": "/search/",
      "method": "GET",
      "keyword_param": "wd",
      "paginator": {"url_template": "/search/{keyword}-------------.html"},
      "verify": {
        "url": "/index.php/ajax/verify_check?type=search",
        "method": "POST",
        "body": {"i": "$token"},
        "token": {"strategy": "maccms_ts_b64", "key_hex": "4e3fa9c2127d88ef55aa0bcddeadbeef"}
      },
      "item": {
        "root_selector": {"css": "a[data-original][href^='/anime/']"},
        "fields": {
          "title": {"css": "a", "attr": "title"},
          "url": {"css": "a", "attr": "href"},
          "cover": {"css": "a", "attr": "data-original"}
        }
      }
    },
    "detail": {
      "url_pattern": "/anime/[a-f0-9]+\\.html",
      "fields": {
        "title": {"css": "h1"},
        "cover": {"css": "a.pic img", "attr": "data-original"},
        "author": {"xpath": "//p[@class='data'][starts-with(.,'导演')]", "regex": "导演：\\s*(\\S+)"},
        "summary": {"fallback": [{"css": ".detail-content"}, {"css": ".detail-sketch"}]},
        "status": {"xpath": "//p[@class='data'][span]", "regex": "状态：(.*)"},
        "tags": {"xpath": "//p[contains(@class,'data') and contains(.,'类型：')]", "regex": "类型：([^/]+)"},
        "clean": {"tags": [["re:\\s+$", ""]]}
      }
    },
    "content": {
      "render_config": {
        "wait_until": "domcontentloaded",
        "timeout_ms": 20000,
        "extra_delay_ms": 2500,
        "slow_fallback_rounds": 0
      },
      "episode": {
        "play_url": {
          "hls_relay_note": "中继 m3u8xx.sgzm.net:2087 已停用（实测）：清单经中继 7.7s、直取 3.5s；且中继会让相对分片（0000000.ts）拼成中继地址 → 404/SSL EOF，播放器反复重试就是「卡顿」。原地址直取清单 200、分片 200，故只留原地址。",
          "render": "playwright_fallback",
          "render_skip_from": ["mp4"],
          "external_player": {
            "from": ["mp4"],
            "budget_s": 10,
            "http_timeout_s": 8,
            "attempts": 1,
            "cache_ttl_s": 900,
            "stale_ttl_s": 21600,
            "prefer_direct": true,
            "note": "精品线路（sid=1）：player_aaaa 只给 32 位不透明 id，真实直链在 art.v2player.top 播放器页面里由 playData(密文, key) 解密（crypto-js + 混淆 common.js）。浏览器渲染实测 47s 仍拿不到，改为 Node 跑站点自己的解密函数。budget_s/http_timeout_s 是**上限**：解析站实测 6~11s 才吐完页面，所以超时必须 ≥8s；但整次取流的总预算是 28s，故解析器一旦启动最多只肯等 10s。代码里还会按剩余预算进一步收窄（剩余 <3s 直接换线）。2026-11-02 现场：解析站与站点主域落在同一台机器（art.v2player.top → 23.225.223.180，与 www.omofuna.com 同 IP），直连 TCP 超时、经系统代理 502/RemoteDisconnected，两个出口同时不可用 → 精品线一整天都取不到流，而暴风线（CDN 打散在别的域名）正常。因此解析结果落盘（stale_ttl_s=6h）：解析站挂掉时用上次成功解析的直链续播，并先确认该直链还能取到字节；解析站连不上则冷却 180s，不再每集白等一次。",
            "player_url": "https://art.v2player.top:8989/player/?url={enc_url}&dmid=&next=&name={name}&sid={sid}&nid={nid}&ph={ph}&h={h}&pic={pic}",
            "cipher_regex": "playData\\(\\s*'([^']+)'\\s*,\\s*'([^']+)'\\s*\\)",
            "scripts": [
              "https://s6.cfhls.top/1/player/js/crypto-js.min.js",
              "https://s6.cfhls.top/1/player/js/common.js"
            ],
            "image_base": "https://as.cfhls.top/",
            "headers": {"Referer": "https://www.omofuna.com/"}
          },
          "probe": {
            "mode": "skip",
            "note": "直连必 403（vip.dytt-hot.com 校验 Host/时效），同一地址经本地媒体代理 200。探测在这里只会白等约 3s、再把可用线路写进死线缓存，故跳过；地址可用性交给播放器/代理首次请求判定。"
          }
        },
        "list": {
          "root_selector": {"css": ".play-list-content li"},
          "fields": {"title": {"css": "a"}, "url": {"css": "a", "attr": "href"}}
        },
        "source_switch": {
          "param": "sid",
          "note": "2026-11 现场：站点只剩两条线路（1=精品、2=暴风），线路 tab 改成 a.play-channel-item[href=/play/<sid>/<n>.html][data-sid][data-count]。精品线是第三方解析器线（player_aaaa.from=mp4，只给不透明 id，要靠 art.v2player.top 二次解密，实测必败且吃掉整个换线预算）；暴风线 player_aaaa.from=bfzym3u8，url 是逐字符 percent 编码的 CDN m3u8，一条 HTTP 直取。默认线路因此改成 2：取流从「先等 9s 解析器失败再换线」变成「一次请求 1~2s 出画面」。",
          "default_sid": "2",
          "list_selector": ".play-channel-item",
          "list_attr": "data-sid",
          "sid_regex": "",
          "name_selector": ".play-channel-item",
          "ep_list_selector": ".play-list-content a[href*='/play/{sid}/']",
          "ep_href_contains": "/play/",
          "detail_url_regex": "(.*/anime/[a-f0-9]+)/play/",
          "detail_url_template": "{1}.html",
          "play_regex": "var player_aaaa=(\\{.*?\\})\\s*</script>",
          "play_url_path": "url",
          "default_parse": "https://art.v2player.top:8989/player/",
          "max_switch_attempts": 2,
          "probe_from_chapter": true
        }
      }
    }
  },
  "decryption": {
    "targets": {
      "video_url": {
        "strategy": "js_custom",
        "entry": "decrypt",
        "script": "function decrypt(d) { return decodeURIComponent(d); }",
        "params": {}
      }
    }
  },
  "media": {
    "format": "hls",
    "select": {"video": {"quality": "best"}},
    "hls": {
      "workers": 4,
      "network_caching_ms": 12000,
      "prefetch": {
        "enabled": true,
        "depth": 8,
        "workers": 3
      }
    }
  },
  "stream_resolver": {
    "candidate_timeout": 15,
    "total_budget": 28,
    "note": "站点单次播放页 TTFB 1~2s，抽风时 8s 读超时；默认线路已是直链暴风线，正常路径只有一次请求。旧值 25/40 是「先跑精品解析器线」时代留的余量，现在只用于给换线一次机会（2 条线路 × 15s 候选超时），超出即失败，让用户立刻看到明确错误而不是干等。"
  },
  "ad_block": {
    "enabled": true,
    "block_url_regex": [
      "/video/adjump(?:/|$)",
      "/video/adpage(?:/|$)"
    ],
    "hls_rules": {
      "remux_timestamps": {"enabled": true},
      "drop_short_blocks": {
        "enabled": true,
        "max_duration": 30,
        "max_ratio": 0.05,
        "require_boundary": true
      }
    }
  },
  "constraints": {"search": {"max_pages": 10, "max_results": 300}, "detail": {"max_pages": 1}, "episode": {"max_pages": 1, "max_items": 1000}, "max_concurrency": 2},
  "diagnostics": {"selfcheck": {"strategy": "soft", "selector": {"css": "a[href^='/anime/']"}}}
}
