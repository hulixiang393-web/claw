{
  "$schema_version": 2,
  "$id": "omofuna",
  "$type": "video",
  "$name": "Omofun动漫",
  "$enabled": true,
  "$weight": 1.0,
  "$metadata": {
    "homepage": "https://www.omofuna.com/",
    "icon": "https://www.omofuna.com/favicon.ico",
    "description": "免费动漫在线站，提供日漫/国漫/动画/剧场/特摄/美漫，详情页提供天堂、精品、暴风、量子四条播放线路（均为 HLS 直链）。",
    "lang": "zh-CN",
    "region": "cn",
    "tags": ["动漫", "免费", "多线路", "HLS"],
    "last_verified": "2026-09-30"
  },
  "transports": {
    "base_url": "https://www.omofuna.com/",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8"
    },
    "timeout": 15,
    "retries": 2,
    "retry_backoff": { "base": 1.0, "max": 4.0, "jitter": 0.3 },
    "interval_ms": 500,
    "charset": "utf-8",
    "follow_redirects": true
  },
  "endpoints": {
    "discovery": {
      "list_url": "/",
      "list_item": {
        "url_pattern": "^https?://[^/]+/type/\\d+-\\{page\\}\\.html$",
        "fields": {
          "title": { "css": ".snui-header-menu-nav li a[href^='/type/']" },
          "url": {
            "css": ".snui-header-menu-nav li a[href^='/type/'][href$='.html']",
            "attr": "href",
            "url_replace": ["^https?://[^/]+/type/([0-9]+)\\.html$", "https://www.omofuna.com/type/{1}-{page}.html"]
          }
        }
      },
      "list_paginator": { "type": "increment" },
      "works_list_url": "/type/5-{page}.html",
      "works_list_item": {
        "root_selector": { "css": "ul.clearfix > li" },
        "fields": {
          "title": { "css": "h4.title a[title]", "attr": "title" },
          "url": { "css": "h4.title a[title]", "attr": "href" },
          "cover": { "css": "a.lazyload", "attr": "data-original" },
          "update": { "css": "a.lazyload span[class*='text-right'] b" }
        }
      }
    },
    "search": {
      "base_url": "/index.php/search/{keyword}-------------.html",
      "method": "GET",
      "item": {
        "root_selector": { "css": "ul.clearfix > li" },
        "fields": {
          "title": { "css": "h4.title a[title]", "attr": "title" },
          "url": { "css": "h4.title a[title]", "attr": "href" },
          "cover": { "css": "a.lazyload", "attr": "data-original" },
          "update": { "css": "a.lazyload span[class*='text-right'] b" }
        },
        "clean": {
          "title": [["re:\\s+", " "]]
        }
      },
      "paginator": {
        "type": "increment",
        "url_template": "/index.php/search/{keyword}-------------{page}.html"
      },
      "max_results": 60,
      "pre_verify": {
        "detect_regex": "mac_verify",
        "url": "/index.php/ajax/verify_check",
        "query": { "type": "search" },
        "sign": { "strategy": "maccms_verify", "param": "i" },
        "success": { "json_path": "code", "equals": 1 }
      }
    },
    "detail": {
      "url_pattern": "^https?://[^/]+/anime/[0-9a-f]{24}\\.html$",
      "fields": {
        "title": { "css": "h1.title" },
        "cover": { "css": "a.pic img", "attr": "data-original" },
        "summary": { "css": "meta[name='description']", "attr": "content" },
        "status": {
          "xpath": "//p[contains(@class,'data')][contains(text(),'状态')]"
        },
        "author": {
          "xpath": "//p[contains(@class,'data')][contains(text(),'导演')]"
        },
        "tags": { "css": "meta[name='keywords']", "attr": "content" },
        "clean": {
          "status": [["re:^状态[:：]\\s*", ""], ["re:\\s+", " "]],
          "author": [["re:^导演[:：]\\s*", ""], ["re:\\s+", " "]],
          "tags": [["re:\\s+", " "]]
        }
      },
      "related": {
        "max": 6,
        "root_selector": { "css": "ul.clearfix > li" },
        "fields": {
          "title": { "css": "h4.title a[title]", "attr": "title" },
          "url": { "css": "h4.title a[title]", "attr": "href" },
          "cover": { "css": "a.lazyload", "attr": "data-original" }
        }
      }
    },
    "content": {
      "episode": {
        "source_switch": {
          "list_selector": "ul.channel-tab li a[href^='#playlist']",
          "list_attr": "href",
          "sid_regex": "playlist(\\d+)$",
          "ep_list_selector": "#playlist{sid} li a",
          "ep_href_contains": "/play/",
          "default_sid": "3",
          "play_regex": "var player_aaaa=(\\{.*?\\})\\s*</script>",
          "play_url_path": "url",
          "playerconfig_url": "/static/player/config/playerconfig.js",
          "detail_url_regex": "^(https?://[^/]+/anime/[0-9a-f]{24})/play/",
          "detail_url_template": "{1}.html",
          "max_switch_attempts": 3
        }
      }
    }
  },
  "decryption": {
    "targets": {
      "video_url": {
        "strategy": "js_custom",
        "entry": "decrypt",
        "script": "function decrypt(d) { return decodeURIComponent(d); }",
        "params": {}
      }
    },
    "cache": {
      "enabled": true,
      "ttl_seconds": 600
    }
  },
  "media": {
    "format": "hls",
    "select": {
      "video": { "quality": "best" },
      "audio": { "lang": "ja" }
    },
    "merge": {
      "tool": "ffmpeg",
      "output_format": "mp4"
    },
    "hls": { "workers": 4, "network_caching_ms": 15000 }
  },
  "constraints": {
    "search": { "max_pages": 1, "max_results": 20, "max_concurrency": 2 },
    "detail": { "max_pages": 1, "timeout_per_page_sec": 20 },
    "episode": { "max_pages": 2 },
    "max_concurrency": 2,
    "global": { "total_timeout_sec": 900 }
  },
  "diagnostics": {
    "selfcheck": {
      "strategy": "soft",
      "selector": { "css": "h4.title a[title]" },
      "interval_hours": 24,
      "max_failures": 3,
      "auto_disable": true
    }
  },
  "ad_block": {
    "enabled": true,
    "extra_css": [".daFJ_aFEaJA__wrGHw", ".vod-ad", ".stui-ad"],
    "block_domains": []
  }
}
